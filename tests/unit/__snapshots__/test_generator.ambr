# name: test_snapshot[ui_main.py]
  '''
  # ui_main — page "main" of weather.espui.
  #
  # Generated by ESP UI Builder: edit the project and generate again instead of
  # editing this file.
  #
  #   ui = ui_main.UI(ui_display.create())
  #   p = dict(ui_main.DEFAULTS)
  #   ui.draw(p)        # full redraw
  #   p[...] = ...
  #   ui.update(p)      # only what changed
  #   ui.set_temperature(value)
  #   ui.set_humidity(value)
  #   ui.set_pressure(value)
  #   ui.set_status(value)
  #   ui.set_city(value)
  #   ui.set_alarm(value)

  import ui_draw as _d
  import ui_fonts as _f

  WIDTH = 320
  HEIGHT = 240

  DEFAULTS = {
      "temperature": 21.5,  # float, -40…85
      "humidity": 40,  # int, 0…100
      "pressure": 1013.2,  # float, 950…1050
      "status": "Норма",  # enum: Норма, Увага, Помилка
      "city": "Київ",  # str, < 20 chars
      "alarm": False,  # bool
  }


  class UI(_d.Page):
      BACKGROUND = 0xC408  # #0b1a22
      DEFAULTS = DEFAULTS
      # (id, x, y, w, h, parameters) in layer order: the first one is the lowest.
      WIDGETS = (
          ("card", 6, 4, 308, 92, ()),
          ("title", 14, 8, 151, 24, ()),
          ("city_txt", 200, 8, 109, 24, ("city",)),
          ("t_val", 14, 40, 283, 48, ("temperature", "alarm")),
          ("sep", 10, 104, 302, 2, ()),
          ("h_bar", 10, 114, 300, 36, ("humidity",)),
          ("p_arc", 10, 160, 120, 66, ("pressure",)),
          ("st_dot", 150, 190, 16, 16, ("status",)),
          ("st_txt", 172, 186, 148, 22, ("status",)),
          ("alarm_lbl", 150, 212, 160, 24, ("alarm",)),
      )

      def set_temperature(self, value):
          self.p["temperature"] = value
          return self.update()

      def set_humidity(self, value):
          self.p["humidity"] = value
          return self.update()

      def set_pressure(self, value):
          self.p["pressure"] = value
          return self.update()

      def set_status(self, value):
          self.p["status"] = value
          return self.update()

      def set_city(self, value):
          self.p["city"] = value
          return self.update()

      def set_alarm(self, value):
          self.p["alarm"] = value
          return self.update()

      def _draw_card(self, fb, ox, oy):
          _d.rrect(fb, 6 - ox, 4 - oy, 308, 92, 4, 0x0511)

      def _draw_title(self, fb, ox, oy):
          _d.label(fb, "Погода", 14 - ox, 8 - oy, 150, 24, 0x199F, _f.SERIF_14, _d.LEFT)

      def _draw_city_txt(self, fb, ox, oy):
          # redrawn when changed: city
          p = self.p
          _d.label(
              fb,
              _d.fmt("%s", p["city"]),
              200 - ox,
              8 - oy,
              108,
              24,
              0x158D,
              _f.SERIF_14,
              _d.RIGHT,
          )

      def _draw_t_val(self, fb, ox, oy):
          # redrawn when changed: temperature, alarm
          p = self.p
          color = 0xFFFF
          # conditions, top to bottom: the lowest one that matches wins
          if p["alarm"]:
              color = 0x4AFA
          _d.label(
              fb,
              _d.fmt("%.1f°C", p["temperature"]),
              14 - ox,
              40 - oy,
              280,
              48,
              color,
              _f.SERIF_40,
              _d.LEFT,
          )

      def _draw_sep(self, fb, ox, oy):
          _d.line(fb, 10 - ox, 104 - oy, 300, 0, 0x8F53)

      def _draw_h_bar(self, fb, ox, oy):
          # redrawn when changed: humidity
          p = self.p
          _d.bar(
              fb,
              10 - ox,
              114 - oy,
              300,
              36,
              _d.frac(p["humidity"], 0, 100),
              0x545E,
              "Вологість, %",
              _d.num(p["humidity"], False),
              _f.SERIF_12,
          )

      def _draw_p_arc(self, fb, ox, oy):
          # redrawn when changed: pressure
          p = self.p
          _d.arc(
              fb,
              10 - ox,
              160 - oy,
              120,
              66,
              _d.frac(p["pressure"], 950.0, 1050.0),
              0x24ED,
              _d.num(p["pressure"], True),
              _f.SERIF_14,
          )

      def _draw_st_dot(self, fb, ox, oy):
          # redrawn when changed: status
          p = self.p
          color = 0xED3D
          # conditions, top to bottom: the lowest one that matches wins
          if p["status"] == "Увага":
              color = 0x24ED
          if p["status"] == "Помилка":
              color = 0x23E9
          _d.ellipse(fb, 150 - ox, 190 - oy, 16, 16, color)

      def _draw_st_txt(self, fb, ox, oy):
          # redrawn when changed: status
          p = self.p
          f = "Стан: %s"
          # conditions, top to bottom: the lowest one that matches wins
          if p["status"] != "Норма":
              f = "Перевірте: %s"
          _d.label(
              fb,
              _d.fmt(f, p["status"]),
              172 - ox,
              186 - oy,
              148,
              22,
              0xFFFF,
              _f.SERIF_12,
              _d.LEFT,
          )

      def _draw_alarm_lbl(self, fb, ox, oy):
          # redrawn when changed: alarm
          p = self.p
          visible = True
          # conditions, top to bottom: the lowest one that matches wins
          if not p["alarm"]:
              visible = False
          if not visible:
              return
          _d.label(fb, "ПЕРЕГРІВ", 150 - ox, 212 - oy, 160, 24, 0x4AFA, _f.SERIF_16, _d.LEFT)

  '''
