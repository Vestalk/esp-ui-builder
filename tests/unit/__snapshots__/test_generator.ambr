# name: test_two_pages_snapshot[main.py]
  '''
  # Example with 2 pages: show(name) switches them (always a full redraw).
  # Generated by ESP UI Builder; when to switch is up to your code (a button, a timer, an event).

  import time

  import ui_display
  import ui_main
  import ui_settings

  d = ui_display.create()
  pages = {
      "main": (ui_main.UI(d), dict(ui_main.DEFAULTS)),
      "settings": (ui_settings.UI(d), dict(ui_settings.DEFAULTS)),
  }
  current = "main"
  ui, p = pages[current]
  ui.draw(p)


  def show(name):
      """Switch to page ``name`` and draw it completely."""
      global current, ui, p
      current = name
      ui, p = pages[name]
      ui.draw(p)


  # Demo: the next page every 5 s; in between the current page animates (tick) and updates.
  order = list(pages)
  last = time.ticks_ms()
  while True:
      ui.tick()
      if time.ticks_diff(time.ticks_ms(), last) >= 5000:
          last = time.ticks_ms()
          show(order[(order.index(current) + 1) % len(order)])
      time.sleep_ms(10)

  '''
