# The page folder as a package: `from <folder> import ui_display, {{ modules[0] }}`
# works wherever the folder lies on the board (e.g. /ui/main), no setup needed.
#
# Generated by ESP UI Builder. Importing it puts this folder on sys.path (the
# files import each other by short names) and points ui_draw at the pictures
# in img/ next to it. A folder copied to the root of the board needs none of it:
# there main.py simply does `import ui_display`.

import os
import sys

_here = __file__.rsplit("/", 1)[0] if "/" in __file__ else "."
if not _here.startswith("/"):  # imported relative to the current folder
    _here = os.getcwd().rstrip("/") + ("" if _here == "." else "/" + _here)
if _here not in sys.path:
    sys.path.insert(0, _here)

import ui_draw

ui_draw.ROOT = _here  # "/img/x.bin" -> <this folder>/img/x.bin

import ui_display
{% for module in modules %}
import {{ module }}
{% endfor %}
