{% if pages | length > 1 %}
# Example with {{ pages | length }} pages: show(name) switches them (always a full redraw).
# Generated by ESP UI Builder; when to switch is up to your code (a button, a timer, an event).

import time

import ui_display
{% for pg in pages %}
import {{ pg.module }}
{% endfor %}

{% if actions %}

# Called when a widget is tapped ("При натиску" in the editor): put your code here.
{% for name in actions %}
def {{ name }}():
    print("tap: {{ name }}")


{% endfor %}
# The editor names the procedure of each button ("При натиску"); here are the procedures.
ACTIONS = {
{% for name in actions %}
    {{ name | py }}: {{ name }},
{% endfor %}
}

{% endif %}
d = ui_display.create()
{% if poll_touch %}
touch = ui_display.create_touch(d)  # touch.read(): (x, y) or None
{% endif %}
pages = {
{% for pg in pages %}
    {{ pg.page.name | py }}: ({{ pg.module }}.UI(d), dict({{ pg.module }}.DEFAULTS)),
{% endfor %}
}
current = {{ pages[0].page.name | py }}
ui, p = pages[current]
{% if actions %}
ui.draw(p, actions=ACTIONS)
ui.listen_touch()  # taps run the procedures in the background
{% else %}
ui.draw(p)
{% endif %}


def show(name):
    """Switch to page ``name`` and draw it completely."""
    global current, ui, p
{% if actions %}
    ui.stop_touch()
{% endif %}
    current = name
    ui, p = pages[name]
{% if actions %}
    ui.draw(p, actions=ACTIONS)
    if ui.TAPS:
        ui.listen_touch()
{% else %}
    ui.draw(p)
{% endif %}


# Demo: the next page every 5 s; in between the current page animates (tick) and updates.
order = list(pages)
last = time.ticks_ms()
while True:
    ui.tick()
{% if poll_touch %}
    point = touch.read()
    if point:
        print("touch", point)
{% endif %}
    if time.ticks_diff(time.ticks_ms(), last) >= 5000:
        last = time.ticks_ms()
        show(order[(order.index(current) + 1) % len(order)])
    time.sleep_ms(10)
{% else %}
# Example for page "{{ page.name }}": draw once, then update in a loop.
# Generated by ESP UI Builder; replace the demo part with your own code.

{% if not first_numeric and first_series %}
import random
{% endif %}
import time

import ui_display
import {{ module }}
{% if actions %}


# Called when a widget is tapped ("При натиску" in the editor): put your code here.
{% for name in actions %}
def {{ name }}():
    print("tap: {{ name }}")


{% endfor %}
# The editor names the procedure of each button ("При натиску"); here are the procedures.
ACTIONS = {
{% for name in actions %}
    {{ name | py }}: {{ name }},
{% endfor %}
}

{% else %}

{% endif %}
{% if touch or actions %}
display = ui_display.create()
ui = {{ module }}.UI(display)
{% else %}
ui = {{ module }}.UI(ui_display.create())
{% endif %}
p = dict({{ module }}.DEFAULTS)
{% if actions %}
ui.draw(p, actions=ACTIONS)
ui.listen_touch()  # taps run the procedures in the background: no loop needed for them
{% else %}
ui.draw(p)
{% endif %}
{% if poll_touch %}
touch = ui_display.create_touch(display)  # touch.read(): (x, y) or None
{% endif %}

{% if anims %}
# Animations run from ui.tick() (non-blocking, ~every 10 ms); parameters change once a second.
last = time.ticks_ms()
while True:
    ui.tick()
{% if poll_touch %}
    point = touch.read()
    if point:
        print("touch", point)
{% endif %}
    if time.ticks_diff(time.ticks_ms(), last) >= 1000:
        last = time.ticks_ms()
        # Change p[...] here, then:
        ui.update(p)
    time.sleep_ms(10)
{% elif first_numeric %}
# Demo: sweep "{{ first_numeric.name }}" and print how long update() takes.
LO, HI = {{ first_numeric.min | py }}, {{ first_numeric.max | py }}
{% if first_numeric.type == "int" %}
step = max(1, (HI - LO) // 50)
{% else %}
step = (HI - LO) / 50
{% endif %}
while True:
{% if poll_touch %}
    point = touch.read()
    if point:
        print("touch", point)
{% endif %}
    value = p[{{ first_numeric.name | py }}] + step
    if value > HI or value < LO:
        step = -step
        value = p[{{ first_numeric.name | py }}] + step
    p[{{ first_numeric.name | py }}] = value
    t0 = time.ticks_us()
    ui.update(p)
    print("update: %d us" % time.ticks_diff(time.ticks_us(), t0))
    time.sleep_ms(200)
{% elif first_series %}
# Demo: add a point to "{{ first_series.name }}" (keeping at most {{ first_series.max_points }}) and time update().
name = {{ first_series.name | py }}
x = len(p[name]) and max(list(m)[0] for m in p[name])
while True:
{% if poll_touch %}
    point = touch.read()
    if point:
        print("touch", point)
{% endif %}
    x += 1
    p[name].append({x: random.uniform({{ first_series.min | py }}, {{ first_series.max | py }})})
    if len(p[name]) > {{ first_series.max_points }}:
        p[name].pop(0)
    t0 = time.ticks_us()
    ui.update(p)
    print("update: %d us, %d points" % (time.ticks_diff(time.ticks_us(), t0), len(p[name])))
    time.sleep_ms(500)
{% elif actions %}
# Nothing else to do here: each tap runs its function and redraws what it changed.
# Your own loop (sensors, timers…) can go here: change p[...] and call ui.update(p).
{% else %}
while True:
{% if poll_touch %}
    point = touch.read()
    if point:
        print("touch", point)
{% endif %}
    # Change p[...] here, then:
    ui.update(p)
    time.sleep_ms(200)
{% endif %}
{% endif %}
