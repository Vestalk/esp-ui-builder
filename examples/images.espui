      "delay_ms": 150
    }
  },
  "pages": [
    {
      "name": "main",
      "background": "#0b1a22",
      "parameters": [
        {
          "name": "weather_icon",
          "type": "str",
          "max_len": 32,
          "default": "/img/sun.bin"
        },
        {
          "name": "temperature",
          "type": "float",
          "min": -20,
          "max": 40,
          "default": 21.5
        }
      ],
      "widgets": [
        {
          "id": "icon",
          "type": "image",
          "x": 20,
          "y": 20,
          "w": 64,
          "h": 64,
          "bind": "weather_icon"
        },
        {
          "id": "t_val",
          "type": "value",
          "x": 100,
          "y": 30,
          "w": 200,
          "h": 48,
          "font_size": 40,
          "bind": "temperature",
          "format": "%.1f°C"
        },
        {
          "id": "logo",
          "type": "image",
          "x": 20,
          "y": 100,
          "w": 120,
          "h": 60,
          "image": {
            "file": "logo",
            "fit": "cover"
          }
        },
        {
          "id": "logo_small",
          "type": "image",
          "x": 160,
          "y": 100,
          "w": 60,
          "h": 30,
          "image": {
            "file": "logo",
            "fit": "contain"
          }
        },
        {
          "id": "spinner",
          "type": "image",
          "x": 240,
          "y": 96,
          "w": 64,
          "h": 64,
          "image": {
            "file": "spinner",
            "play": "loop"
          }
        },
        {
          "id": "loading",
          "type": "image",
          "x": 20,
          "y": 190,
          "w": 128,
          "h": 32,
          "image": {
            "file": "loading",
            "fit": "fill",
            "play": "once"
          }
        },
        {
          "id": "ghost",
          "type": "image",
          "x": 180,
          "y": 180,
          "w": 48,
          "h": 48,
          "opacity": 60,
          "image": {
            "file": "sun"
          }
        }
      ]
    }
  ]
}
