      "data": "",
      "width": 64,
      "height": 64,
      "frames": null,
      "delay_ms": null
    },
    "cloud": {
      "name": "cloud.png",
      "path": "/img/cloud.bin",
      "mime": "image/png",
      "data": "",
      "width": 64,
      "height": 64,
      "frames": null,
      "delay_ms": null
    },
    "rain": {
      "name": "rain.png",
      "path": "/img/rain.bin",
      "mime": "image/png",
      "data": "",
      "width": 64,
      "height": 64,
      "frames": null,
      "delay_ms": null
    },
    "logo": {
      "name": "logo.jpg",
      "path": "/img/logo.bin",
      "mime": "image/jpeg",
      "data": "",
      "width": 120,
      "height": 60,
      "frames": null,
      "delay_ms": null
    },
    "spinner": {
      "name": "spinner.gif",
      "path": "/img/spinner/",
      "mime": "image/gif",
      "data": "",
